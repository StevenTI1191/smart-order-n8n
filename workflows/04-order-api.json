    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT coalesce(json_agg(o ORDER BY o.created_at DESC), '[]'::json) FROM (\n     SELECT id, order_id, source, customer_name, phone, city, items, item_qty,\n            payment_method, total, risk_score, risk_level, risk_reasons, tags,\n            ai_verdict, ai_confidence, ai_reason, status, decided_by, created_at, updated_at\n       FROM orders\n      WHERE $1 = 'ALL' OR status = $1\n      ORDER BY created_at DESC\n      LIMIT 200) o)                                                     AS orders,\n  (SELECT coalesce(json_agg(l ORDER BY l.created_at DESC), '[]'::json) FROM (\n     SELECT order_id, action, actor, note, created_at\n       FROM order_logs\n      ORDER BY created_at DESC\n      LIMIT 30) l)                                                      AS activity;",
        "options": {
          "queryReplacement": "={{ [String($json.query?.status || 'ALL').toUpperCase().replace(/[^A-Z_]/g, '') || 'ALL'] }}"
        }
      },
      "id": "53d25235-7dc7-41ba-a5e0-1710ee4c5d53",
      "name": "Daftar Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "orders-db",
          "name": "Orders DB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, orders: $json.orders || [], activity: $json.activity || [] }) }}",
        "options": {
          "responseCode": 200
        }
      },
