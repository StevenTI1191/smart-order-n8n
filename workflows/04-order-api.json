    {
      "parameters": {
        "jsCode": "// Node: \"Cek Keputusan\"  (Code node, workflow \"[Order] API\", mode: Run Once for All Items)\n// Input : Webhook \"Keputusan\" (POST /webhook/api/decide)\n// Body  : { \"id\": 12, \"decision\": \"APPROVE\" | \"REJECT\", \"by\": \"steven@email.com\" }\n// Output: { valid, error, params: [status_baru, oleh, id] } untuk query Q4.\n// Siapa yang menekan tombol diisi oleh server website (dari login Cloudflare Access),\n// bukan dari browser, jadi tidak bisa dipalsukan pengunjung.\n\nconst b = $input.first().json.body || {};\nconst id = String(b.id ?? '').trim();\nconst decision = String(b.decision || '').toUpperCase();\nconst status_baru = decision === 'APPROVE' ? 'APPROVED_MANUAL' : decision === 'REJECT' ? 'REJECTED' : null;\nconst oleh = String(b.by || 'admin').replace(/[^\\w@.+-]/g, '').slice(0, 80) || 'admin';\n\nlet error = null;\nif (!/^\\d{1,18}$/.test(id)) error = 'id tidak valid';\nelse if (!status_baru) error = 'decision harus APPROVE atau REJECT';\n\nreturn [{\n  json: {\n    valid: !error,\n    error,\n    id,\n    status_baru,\n    oleh: 'web:' + oleh,\n    params: [status_baru, 'web:' + oleh, id],\n  },\n}];\n"
      },
      "id": "cf71cab5-65dc-4ac6-8efb-134756c3a45c",
      "name": "Cek Keputusan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ef4d13ad-a926-40cc-9ea7-2611cc568c9d",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5c05058a-6c67-4ddb-896d-8c05be65bf9a",
